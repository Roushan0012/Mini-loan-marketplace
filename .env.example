# ==============================================
# Mini Loan Marketplace - Environment Configuration
# ==============================================
# Copy this file to .env and adjust variables as needed.
# Note: Fictional/dummy credentials only.

# Environment
ENVIRONMENT=development
DEBUG=True

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="Mini Loan Marketplace"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mock Lender Webhook Configuration (HMAC-SHA256 signature verification)
# Generate locally: python3 -c "import secrets; print(secrets.token_hex(32))"
MOCK_LENDER_WEBHOOK_SECRET=change-this-to-a-secure-webhook-secret-key-in-local-env

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
POSTGRES_DB=mini_loan_marketplace
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SERVER=localhost
DATABASE_URL=postgresql+psycopg://marketplace_user:local_dev_password_change_me@localhost:5432/mini_loan_marketplace

# Mock Lender Simulation Settings (Fictional Partners)
# Simulated latency in milliseconds for mock lender response
MOCK_LENDER_RESPONSE_DELAY_MS=500
ENABLE_MOCK_LENDER_APEX=True
ENABLE_MOCK_LENDER_HORIZON=True
ENABLE_MOCK_LENDER_STERLING=True

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
