# Dedicated E2E Test Credentials Template
# Copy this file to .env.e2e.local and populate with unique values.
# IMPORTANT:
# - All email addresses must start with the 'e2e_' prefix.
# - All passwords must be at least 12 characters long.
# - Credentials for different roles must be distinct and non-identical.
# - Never commit .env.e2e.local to source control.

E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_CALLER_EMAIL=
E2E_CALLER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
